DATABASE_URL=postgresql+asyncpg://vetlanh:vetlanh_password@localhost:5432/vetlanh_db
SECRET_KEY=change-this-to-a-random-secret-key
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Email — Mailtrap sandbox for dev, live SMTP in prod
# Get credentials from: https://mailtrap.io → Inboxes → SMTP Settings
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=587
SMTP_USER=your-mailtrap-username
SMTP_PASSWORD=your-mailtrap-password
SMTP_FROM=noreply@vetlanh.app

# Base URL used in verification email links
APP_BASE_URL=http://localhost:8000

POSTGRES_USER=vetlanh
POSTGRES_PASSWORD=vetlanh_password
POSTGRES_DB=vetlanh_db
