# =============================================================================
# vetlanh-be — Environment Variable Template
# =============================================================================
# Copy this file to .env and fill in real values for local development.
# NEVER commit .env — it is git-ignored.
# Production values are managed exclusively in the Vercel dashboard.
# =============================================================================

# -----------------------------------------------------------------------------
# Core — REQUIRED (app will refuse to start if missing)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql+asyncpg://user:pass@localhost:5432/vetlanh_db
SECRET_KEY=replace-with-a-random-string-of-at-least-32-characters
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Fernet symmetric key for encrypting journal content at rest.
# Generate one with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
JOURNAL_ENCRYPTION_KEY=replace-with-fernet-key

# Groq API key for AI chat (LLaMA 3)
GROQ_API_KEY=gsk_replace-with-groq-api-key

# -----------------------------------------------------------------------------
# Email — Resend API (optional locally; required in production)
# -----------------------------------------------------------------------------
RESEND_API_KEY=re_replace-with-resend-api-key
EMAIL_FROM=noreply@vetlanh.io.vn

# -----------------------------------------------------------------------------
# URLs
# -----------------------------------------------------------------------------
# Public origin of this backend server — used to build verification links in emails.
# Local: http://localhost:8000  |  Production: https://api.vetlanh.io.vn
APP_BASE_URL=http://localhost:8000

# Primary frontend origin for CORS and redirect links.
# Local: http://localhost:5173  |  Production: https://vetlanh.io.vn
FRONTEND_URL=http://localhost:5173

# Frontend base URL used in email links (verification, password reset).
FRONTEND_BASE_URL=http://localhost:3000

# Extra comma-separated origins to add to the CORS allowlist.
# Example: CORS_ORIGINS=https://vetlanh.io.vn,https://www.vetlanh.io.vn
CORS_ORIGINS=

# -----------------------------------------------------------------------------
# Google OAuth2 (optional locally; required in production)
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=replace-with-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace-with-google-client-secret
# Must match exactly what is registered in Google Cloud Console.
# Local: http://localhost:8000/api/v1/auth/google/callback
# Production: https://api.vetlanh.io.vn/api/v1/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# -----------------------------------------------------------------------------
# Admin
# -----------------------------------------------------------------------------
# Comma-separated list of usernames or emails with admin access.
ADMIN_USERS=duy1
# Comma-separated emails to notify when a new payment bill is submitted.
ADMIN_NOTIFICATION_EMAILS=your-email@example.com

# -----------------------------------------------------------------------------
# Cloudinary — image and audio storage (REQUIRED)
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=replace-with-cloud-name
CLOUDINARY_API_KEY=replace-with-api-key
CLOUDINARY_API_SECRET=replace-with-api-secret

# -----------------------------------------------------------------------------
# Storage (local dev only — Vercel uses /tmp automatically)
# -----------------------------------------------------------------------------
UPLOADS_DIR=uploads

# -----------------------------------------------------------------------------
# Docker Compose (local dev only — not read by the FastAPI app)
# -----------------------------------------------------------------------------
POSTGRES_USER=user
POSTGRES_PASSWORD=pass
POSTGRES_DB=vetlanh_db
